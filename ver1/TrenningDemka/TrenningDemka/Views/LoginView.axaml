<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TrenningDemka.Views.LoginView"
             xmlns:vm="using:TrenningDemka.ViewModels"
             x:DataType="vm:LoginViewModel"
             xmlns:converters="using:TrenningDemka.Converters"
             Tag="Страница авторизации">


    <UserControl.Resources>
        <converters:ImageConvert x:Key="ImgConv"/>
        <converters:ColorConverter x:Key="ColorConv"/>
    </UserControl.Resources>

   <StackPanel HorizontalAlignment="Center" Spacing="10">
        
        <TextBlock Grid.Row="0" Text="{Binding PageTitle}"
                FontSize="16"
                FontWeight="SemiBold"
                Padding="10, 5"
                HorizontalAlignment="Center"/>

       <TextBox Text="{Binding EnterLogin}" Watermark="login"/>
       <Button Command="{Binding LogInCommand}" HorizontalAlignment="Center">
           <TextBlock Text="Login"></TextBlock>
       </Button>
       <TextBlock Text="{Binding ErrorsLogin}"></TextBlock>
   </StackPanel>
    

</UserControl>
